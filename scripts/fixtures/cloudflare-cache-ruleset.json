{
  "id": "rs-123",
  "version": "v7",
  "name": "storefront-cache",
  "kind": "zone",
  "phase": "http_request_cache_settings",
  "rules": [
    {
      "ref": "html",
      "description": "Cache HTML pages",
      "expression": "(http.host eq \"petposture.com\") and (not starts_with(http.request.uri.path, \"/api/\"))",
      "action": "set_cache_settings",
      "action_parameters": { "cache": true }
    },
    {
      "ref": "api",
      "description": "Cache safe public catalog/content API GET endpoints (5 min edge TTL)",
      "expression": "(http.host eq \"api.petposture.com\") and (http.request.method eq \"GET\") and (http.request.uri.path matches \"^/(catalog|content)/\")",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": { "mode": "override", "default": 300 }
      }
    },
    {
      "ref": "other",
      "description": "Other cache rule",
      "expression": "(http.host eq \"petposture.com\")"
    }
  ]
}
